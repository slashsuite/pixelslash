# The bundle renderer (deploy/ssh/render-worker.ts; docs/storybook-bundle-render.md, section 3):
# headless Chromium running a pull request's Storybook bundle, which is untrusted code. It runs
# beside pixelslash-web on the CT, so it is fenced in here: its own user with no login and no access
# to the app's state or secrets, loopback only (the review app's API on :3000 and its own :3100,
# no route anywhere else), a read-only system, a private /tmp that holds each job's bundle and is
# removed with it, and Chromium's own sandbox left on (no --no-sandbox, and user namespaces are not
# restricted, since the sandbox needs them). update.sh installs it only when the CT's
# .dev.vars.e2e names a RENDER_URL; apps/web/README.md, "Run it on the Proxmox server".
# Its queue lives in its state directory (RENDER_QUEUE), so a restart drops no build. A stop goes to
# the worker alone (KillMode=mixed: not to its Chromium), which lets the builds it is rendering
# finish, then exits; one still rendering at TimeoutStopSec is killed and rendered again on start.
[Unit]
Description=PixelSlash bundle renderer
After=network-online.target pixelslash-web.service
Wants=network-online.target

[Service]
User=pixelslash-render
Group=pixelslash-render
WorkingDirectory=/home/pixelslash/releases/current/apps/web
Environment=PATH=/home/pixelslash/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/pixelslash-render
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/pixelslash-render/browsers
Environment=TMPDIR=/tmp
Environment=RENDER_HOST=127.0.0.1
Environment=RENDER_PORT=3100
Environment=RENDER_API=http://127.0.0.1:3000
Environment=RENDER_QUEUE=/var/lib/pixelslash-render/queue.json
# Two builds at once, each with its own browser: a pull request's builds overlap their fixed costs
# (apps/web/README.md, "The bundle renderer"). Two shots each, so four pages on the CT's four cores,
# as fast as four each over eleven builds: each pooled page holds every story it has switched to,
# and two builds of four pages each reached this unit's old 3000M and were killed.
Environment=RENDER_BUILDS=2
Environment=RENDER_CONCURRENCY=2
ExecStart=/home/pixelslash/.bun/bin/bun deploy/ssh/render-worker.ts
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=20min
StateDirectory=pixelslash-render
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/home/pixelslash/pixelslash/apps/web/.wrangler -/home/pixelslash/pixelslash/apps/web/.dev.vars.e2e
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
IPAddressDeny=any
IPAddressAllow=localhost
# One build of 238 shots peaked at 2.85 GB here at four shots at once; two builds at two shots each
# measured 2.7 GB locally, an estimated 3.5 to 3.7 GB here with this unit's own process and the
# uploads. 4000M and the web app's 4000M are ceilings within the CT's 8192 MiB. Over this the kernel kills the renderer; it starts
# again and renders those builds again, one at a time, and a build it is killed under three times
# ends errored, naming why.
MemoryMax=4000M
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
