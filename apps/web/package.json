{
  "name": "@pixelslash/web",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PIXELSLASH_E2E_DEV=1 playwright test",
    "test:e2e:docker": "playwright test -c deploy/docker/playwright.config.ts",
    "dogfood:upload": "rm -rf .wrangler/dogfood-snapshots && bun ../../packages/cli/src/index.ts capture --config e2e/dogfood-review.config.ts --out .wrangler/dogfood-snapshots --upload --server \"${PIXELSLASH_SERVER:?set PIXELSLASH_SERVER}\" --token-path \"${PIXELSLASH_TOKEN_FILE:?set PIXELSLASH_TOKEN_FILE}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.12.0",
    "@sentry/react": "11.12.0",
    "@slashsuite/pixelslash-engine": "workspace:*",
    "@slashsuite/themes": "^0.5.0",
    "@slashsuite/ui-react": "^0.15.2",
    "@tailwindcss/vite": "catalog:tailwind",
    "@tanstack/react-router": "catalog:tanstack",
    "@tanstack/react-start": "catalog:tanstack",
    "drizzle-orm": "^0.45.4",
    "miniflare": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:tailwind",
    "wrangler": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@playwright/test": "catalog:playwright",
    "@tanstack/router-cli": "catalog:tanstack",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
