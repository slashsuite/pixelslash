{
  "name": "pixelslash-workspace",
  "private": true,
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "bench",
    "docker/self-host"
  ],
  "type": "module",
  "scripts": {
    "pixelslash": "bun packages/cli/src/index.ts",
    "typecheck": "bun scripts/moon.ts run --concurrency 3 :typecheck",
    "lint": "bun scripts/moon.ts run --concurrency 3 :lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun scripts/moon.ts run --concurrency 3 :test",
    "bench": "bun scripts/moon.ts run bench:bench --output-style stream --",
    "bench:check": "bun scripts/moon.ts run bench:check --output-style stream --",
    "bench:perf": "bun bench/src/perf/run.ts",
    "bench:native": "bun bench/src/perf/native.ts",
    "bench:perf:check": "bun bench/src/perf/run.ts --check",
    "bench:import-flags": "bun bench/src/import-flags.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "build:playwright": "bun scripts/build-playwright.ts",
    "check:example": "bun scripts/check-example.ts",
    "wasm:build": "bun scripts/build-wasm.ts",
    "wasm:check": "bun scripts/build-wasm.ts --check"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@playwright/test": "catalog:playwright",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "pngjs": "catalog:",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "catalog": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "miniflare": "5.20261019.0-beta",
    "pngjs": "^7.0.0",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "wrangler": "^4.162.0"
  },
  "catalogs": {
    "playwright": {
      "@playwright/test": "1.65.1",
      "playwright": "1.65.1"
    },
    "react": {
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.5",
      "tailwindcss": "^4.1.18"
    },
    "tanstack": {
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.5",
      "@tanstack/router-cli": "^1.168.0"
    }
  },
  "trustedDependencies": [
    "@moonrepo/cli"
  ]
}
