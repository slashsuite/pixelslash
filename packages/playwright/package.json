{
  "name": "@slashsuite/pixelslash-playwright",
  "version": "0.1.0",
  "description": "Take PixelSlash snapshots from your own Playwright tests: snapshot(page, name) writes a dir `pixelslash upload` takes.",
  "keywords": [
    "pixel-diff",
    "playwright",
    "screenshot",
    "visual-regression"
  ],
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashsuite/pixelslash.git",
    "directory": "packages/playwright"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "catalog:playwright",
    "@slashsuite/pixelslash": "workspace:*",
    "@slashsuite/pixelslash-engine": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pngjs": "catalog:",
    "playwright": "catalog:playwright",
    "pngjs": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
